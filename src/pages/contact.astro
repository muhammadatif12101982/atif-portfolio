---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact | Muhammad Atif"
  description="Contact Muhammad Atif for senior software engineering, SharePoint, Power Platform, and AI engineering opportunities."
>
  <section class="mx-auto max-w-5xl px-6 py-20">
    <div class="max-w-3xl">
      <p
        class="text-sm font-semibold uppercase tracking-widest text-green-400"
      >
        Contact
      </p>

      <h1
        class="mt-4 text-4xl font-bold tracking-tight text-slate-100 md:text-5xl"
      >
        Let's build something meaningful.
      </h1>

      <p class="mt-6 text-lg leading-8 text-slate-300">
        I am open to senior software engineering, enterprise architecture,
        SharePoint & Power Platform, and AI engineering opportunities.
      </p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-2">
      <a
        href="mailto:muhammadatif12101982@gmail.com"
        class="rounded-2xl border border-slate-800 bg-slate-950 p-6 shadow-sm transition hover:-translate-y-1 hover:border-slate-700 hover:shadow-md"
      >
        <p
          class="text-sm font-semibold uppercase tracking-wide text-slate-400"
        >
          Email
        </p>

        <h2 class="mt-2 text-xl font-semibold text-slate-100">
          muhammadatif12101982@gmail.com
        </h2>

        <p class="mt-3 text-slate-300">
          Best for recruitment and professional opportunities.
        </p>
      </a>

      <a
        href="https://www.linkedin.com/in/mhatif"
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-2xl border border-slate-800 bg-slate-950 p-6 shadow-sm transition hover:-translate-y-1 hover:border-slate-700 hover:shadow-md"
      >
        <p
          class="text-sm font-semibold uppercase tracking-wide text-slate-400"
        >
          LinkedIn
        </p>

        <h2 class="mt-2 text-xl font-semibold text-slate-100">
          Connect on LinkedIn
        </h2>

        <p class="mt-3 text-slate-300">
          Professional profile, experience, and career opportunities.
        </p>
      </a>
    </div>

    <div
      class="mt-10 rounded-2xl border border-slate-800 bg-slate-900 p-8 text-white"
    >
      <p
        class="text-sm font-semibold uppercase tracking-wide text-slate-400"
      >
        Areas of interest
      </p>

      <div class="mt-5 flex flex-wrap gap-3">
        <span class="skill-tag">Senior Software Engineering</span>
        <span class="skill-tag">.NET / C#</span>
        <span class="skill-tag">SharePoint</span>
        <span class="skill-tag">Power Platform</span>
        <span class="skill-tag">Microsoft 365</span>
        <span class="skill-tag">AI / LLM</span>
        <span class="skill-tag">RAG</span>
        <span class="skill-tag">Solution Architecture</span>
      </div>
    </div>
  </section>
</BaseLayout>