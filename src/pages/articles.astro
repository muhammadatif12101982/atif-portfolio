---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const articles = await getCollection("articles");

const sortedArticles = articles.sort(
  (a, b) =>
    new Date(b.data.publishedDate).getTime() -
    new Date(a.data.publishedDate).getTime()
);
---

<BaseLayout
  title="Technical Articles | Muhammad Atif"
  description="Technical articles and engineering insights on .NET, SharePoint, Microsoft 365, Power Platform, AI, RAG, and enterprise software engineering."
>
  <section class="mx-auto max-w-6xl px-6 py-16 lg:py-24">
    <div class="max-w-3xl">
      <p
        class="mb-4 text-sm font-semibold uppercase tracking-widest text-green-400"
      >
        Technical Articles
      </p>

      <h1 class="text-4xl font-bold tracking-tight text-slate-100 md:text-5xl">
  Technical articles on enterprise software and AI engineering
</h1>

<p class="mt-6 max-w-3xl text-xl leading-8 text-slate-300">
  Practical engineering insights covering .NET, Microsoft 365, SharePoint,
  Power Platform, AI, RAG, LLM applications, and modern enterprise
  architecture.
</p>
    </div>

    <div class="mt-12 grid gap-8 md:grid-cols-2">
      {
        sortedArticles.map((article) => (
          <article class="group rounded-2xl border border-slate-800 bg-slate-950 p-8 shadow-sm transition hover:-translate-y-1 hover:border-slate-700 hover:shadow-lg">
            <div class="flex items-center gap-3 text-sm text-slate-400">
              <time datetime={article.data.publishedDate.toISOString()}>
                {new Date(article.data.publishedDate).toLocaleDateString(
                  "en-US",
                  {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  }
                )}
              </time>

              <span>•</span>

              <span>{article.data.tags.join(" · ")}</span>
            </div>

            <h2
              class="mt-5 text-2xl font-bold leading-tight text-slate-100 group-hover:text-green-400"
            >
              {article.data.title}
            </h2>

            <p class="mt-4 leading-7 text-slate-300">
              {article.data.description}
            </p>

            <a
              href={`/articles/${article.id}/`}
              class="mt-6 inline-flex items-center font-semibold text-green-400 hover:text-green-300"
            >
              Read article
              <span class="ml-2 transition-transform group-hover:translate-x-1">
                →
              </span>
            </a>
          </article>
        ))
      }
    </div>

    {
      sortedArticles.length === 0 && (
        <div class="mt-12 rounded-2xl border border-dashed border-slate-700 p-12 text-center">
          <p class="text-slate-400">
            Technical articles will appear here soon.
          </p>
        </div>
      )
    }
  </section>
</BaseLayout>