---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Resume | Muhammad Atif"
  description="Resume of Muhammad Atif, Senior Software Engineer specializing in .NET, SharePoint, Microsoft 365, Power Platform, cloud, and AI."
>
  <section class="mx-auto max-w-6xl px-6 py-16">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-slate-400">
        Career Profile
      </p>

      <h1
        class="mt-3 text-4xl font-bold tracking-tight text-slate-100 md:text-5xl"
      >
        Resume
      </h1>

      <p class="mt-5 text-lg leading-8 text-slate-300">
        Senior Software Engineer with 18+ years of experience delivering
        enterprise applications, Microsoft platforms, automation solutions,
        cloud systems, and AI-powered solutions.
      </p>
    </div>

    <div class="mt-12 rounded-2xl border border-slate-800 bg-slate-900/60 p-8">
      <div
        class="flex flex-col justify-between gap-6 md:flex-row md:items-center"
      >
        <div>
          <h2 class="text-2xl font-bold text-slate-100">
            Download my resume
          </h2>

          <p class="mt-2 text-slate-300">
            Choose the version that best matches the opportunity.
          </p>
        </div>

        <div class="flex flex-wrap gap-3">
          <a
            href="#software-engineer"
            class="rounded-lg bg-slate-100 px-5 py-3 font-semibold text-slate-900 transition hover:bg-white"
          >
            Software Engineer
          </a>

          <a
            href="#sharepoint-power-platform"
            class="rounded-lg border border-slate-700 bg-slate-950 px-5 py-3 font-semibold text-slate-100 transition hover:bg-slate-800"
          >
            SharePoint / Power Platform
          </a>
        </div>
      </div>
    </div>

    <div class="mt-12 grid gap-8 lg:grid-cols-2">
      <article
        id="software-engineer"
        class="rounded-2xl border border-slate-800 bg-slate-950 p-8 shadow-sm"
      >
        <p
          class="text-sm font-semibold uppercase tracking-widest text-slate-400"
        >
          Positioning
        </p>

        <h2 class="mt-3 text-2xl font-bold text-slate-100">
          Senior Software Engineer
        </h2>

        <p class="mt-4 leading-7 text-slate-300">
          Best suited for backend, full-stack, enterprise software, cloud,
          architecture, and AI engineering opportunities.
        </p>

        <div class="mt-6 flex flex-wrap gap-2">
          <span class="skill-tag">C#</span>
          <span class="skill-tag">.NET</span>
          <span class="skill-tag">ASP.NET Core</span>
          <span class="skill-tag">REST APIs</span>
          <span class="skill-tag">Microservices</span>
          <span class="skill-tag">SQL Server</span>
          <span class="skill-tag">Azure</span>
          <span class="skill-tag">Docker</span>
          <span class="skill-tag">AI / LLMs</span>
          <span class="skill-tag">RAG</span>
        </div>

        <div class="mt-8">
          <a
            href="/resumes/Muhammad_Atif_Senior_Software_Engineer_Resume.pdf"
            download
            class="inline-flex rounded-lg bg-slate-100 px-5 py-3 font-semibold text-slate-900 transition hover:bg-white"
          >
            Download Software Engineer Resume
          </a>
        </div>
      </article>

      <article
        id="sharepoint-power-platform"
        class="rounded-2xl border border-slate-800 bg-slate-950 p-8 shadow-sm"
      >
        <p
          class="text-sm font-semibold uppercase tracking-widest text-slate-400"
        >
          Positioning
        </p>

        <h2 class="mt-3 text-2xl font-bold text-slate-100">
          SharePoint & Power Platform Specialist
        </h2>

        <p class="mt-4 leading-7 text-slate-300">
          Best suited for SharePoint, Microsoft 365, SPFx, Power Apps,
          Power Automate, migration, modernization, and solution architecture
          opportunities.
        </p>

        <div class="mt-6 flex flex-wrap gap-2">
          <span class="skill-tag">SharePoint</span>
          <span class="skill-tag">SharePoint Online</span>
          <span class="skill-tag">SPFx</span>
          <span class="skill-tag">React</span>
          <span class="skill-tag">TypeScript</span>
          <span class="skill-tag">Power Apps</span>
          <span class="skill-tag">Power Automate</span>
          <span class="skill-tag">Microsoft 365</span>
          <span class="skill-tag">PowerShell</span>
          <span class="skill-tag">Migration</span>
        </div>

        <div class="mt-8">
          <a
            href="/resumes/Muhammad_Atif_SharePoint_Power_Platform_Developer_Resume.pdf"
            download
            class="inline-flex rounded-lg bg-slate-100 px-5 py-3 font-semibold text-slate-900 transition hover:bg-white"
          >
            Download SharePoint Resume
          </a>
        </div>
      </article>
    </div>

    <section
      class="mt-12 rounded-2xl border border-slate-800 bg-slate-950 p-8 shadow-sm"
    >
      <h2 class="text-2xl font-bold text-slate-100">
        Career Highlights
      </h2>

      <div class="mt-8 grid gap-8 md:grid-cols-4">
        <div>
          <div class="text-3xl font-bold text-slate-100">18+</div>
          <p class="mt-2 text-sm leading-6 text-slate-400">
            Years of software engineering experience
          </p>
        </div>

        <div>
          <div class="text-3xl font-bold text-slate-100">7TB+</div>
          <p class="mt-2 text-sm leading-6 text-slate-400">
            Enterprise data migration experience
          </p>
        </div>

        <div>
          <div class="text-3xl font-bold text-slate-100">15+</div>
          <p class="mt-2 text-sm leading-6 text-slate-400">
            Applications and workflows delivered
          </p>
        </div>

        <div>
          <div class="text-3xl font-bold text-slate-100">GCC</div>
          <p class="mt-2 text-sm leading-6 text-slate-400">
            Enterprise delivery experience
          </p>
        </div>
      </div>
    </section>
  </section>
</BaseLayout>