---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");

const sortedProjects = projects.sort((a, b) => {
  if (a.data.featured !== b.data.featured) {
    return a.data.featured ? -1 : 1;
  }

  return (b.data.year ?? "").localeCompare(a.data.year ?? "");
});
---

<BaseLayout
  title="Projects | Muhammad Atif"
  description="Selected enterprise software, Microsoft 365, SharePoint, Power Platform, and AI engineering projects."
>
  <section class="mx-auto max-w-6xl px-6 py-16">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-slate-400">
        Selected Work
      </p>

      <h1 class="text-4xl font-bold tracking-tight text-slate-100 md:text-5xl">
  Enterprise software, modernization, and AI engineering projects
</h1>

<p class="mt-6 max-w-3xl text-xl leading-8 text-slate-300">
  Selected engineering engagements covering large-scale SharePoint and
  Microsoft 365 migrations, enterprise application modernization,
  Power Platform automation, and AI-powered knowledge systems delivered
  across GCC organizations.
</p>
    </div>

    <div class="mt-12 grid gap-8 md:grid-cols-2">
      {
        sortedProjects.map((project) => (
          <article class="flex flex-col rounded-2xl border border-slate-800 bg-slate-950 p-7 shadow-sm transition hover:-translate-y-1 hover:border-slate-700 hover:shadow-md">
            <div class="flex items-center justify-between gap-4">
              <span class="text-sm font-medium text-slate-400">
                {project.data.category}
              </span>

              {project.data.year && (
                <span class="text-sm text-slate-500">
                  {project.data.year}
                </span>
              )}
            </div>

            <h2 class="mt-4 text-2xl font-bold tracking-tight text-slate-100">
              {project.data.title}
            </h2>

            <p class="mt-2 text-sm font-medium text-slate-400">
              {project.data.client}
            </p>

            <p class="mt-5 flex-1 leading-7 text-slate-300">
              {project.data.description}
            </p>

            {project.data.metrics && (
              <div class="mt-6 grid grid-cols-3 gap-3 border-y border-slate-800 py-5">
                {project.data.metrics.map((metric) => (
                  <div>
                    <div class="text-xl font-bold text-slate-100">
                      {metric.value}
                    </div>

                    <div class="mt-1 text-xs leading-4 text-slate-400">
                      {metric.label}
                    </div>
                  </div>
                ))}
              </div>
            )}

            <div class="mt-6 flex flex-wrap gap-2">
              {project.data.technologies.map((technology) => (
                <span class="skill-tag">
                  {technology}
                </span>
              ))}
            </div>

            <a
              href={`/projects/${project.id}/`}
              class="mt-7 inline-flex items-center font-semibold text-sky-400 hover:text-sky-300"
            >
              View case study
              <span class="ml-2" aria-hidden="true">→</span>
            </a>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>