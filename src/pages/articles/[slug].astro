---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const articles = await getCollection("articles");

  return articles.map((article) => ({
    params: {
      slug: article.id,
    },
    props: {
      article,
    },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
---

<BaseLayout
  title={`${article.data.title} | Muhammad Atif`}
  description={article.data.description}
>
  <article class="mx-auto max-w-4xl px-6 py-16 lg:py-24">
    <header class="mb-12">
      <a
        href="/articles/"
        class="inline-flex items-center text-sm font-semibold text-green-400 hover:text-green-300"
      >
        ← Back to Articles
      </a>

      <div class="mt-8">
        <p
          class="text-sm font-semibold uppercase tracking-widest text-green-400"
        >
          Technical Article
        </p>

        <h1
          class="mt-4 text-4xl font-bold tracking-tight text-slate-100 md:text-5xl"
        >
          {article.data.title}
        </h1>

        <p class="mt-6 text-xl leading-8 text-slate-300">
          {article.data.description}
        </p>

        <div
          class="mt-6 flex flex-wrap items-center gap-3 text-sm text-slate-400"
        >
          <time datetime={article.data.publishedDate.toISOString()}>
            {article.data.publishedDate.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
          </time>

          <span>•</span>

          {
            article.data.tags.map((tag) => (
              <span
                class="rounded-full border border-slate-700 bg-slate-900 px-3 py-1 text-slate-300"
              >
                {tag}
              </span>
            ))
          }
        </div>
      </div>
    </header>

    <div
      class="prose prose-lg max-w-none
             prose-headings:font-bold prose-headings:text-slate-100
             prose-p:text-slate-300 prose-p:leading-8
             prose-a:text-green-400
             prose-a:no-underline hover:prose-a:text-green-300
             prose-strong:text-slate-100
             prose-code:text-slate-200
             prose-pre:rounded-xl
             prose-pre:border
             prose-pre:border-slate-700
             prose-pre:bg-slate-900
             prose-pre:text-slate-100
             prose-li:text-slate-300
             prose-blockquote:border-slate-700
             prose-blockquote:text-slate-300"
    >
      <Content />
    </div>

    <footer class="mt-16 border-t border-slate-800 pt-8">
      <a
        href="/articles/"
        class="inline-flex items-center font-semibold text-green-400 hover:text-green-300"
      >
        ← Back to all articles
      </a>
    </footer>
  </article>
</BaseLayout>