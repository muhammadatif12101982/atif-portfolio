---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Muhammad Atif — Senior Software Engineer specializing in .NET, Microsoft 365, SharePoint, Power Platform, and AI.",
} = Astro.props;

const siteUrl = "https://atif.is-a.dev";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const pageTitle = title;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="author" content="Muhammad Atif" />
    <meta name="theme-color" content="#020617" />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Muhammad Atif" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <title>{pageTitle}</title>
  </head>

  <body class="min-h-screen bg-slate-950 text-slate-100 antialiased">
    <header class="border-b border-slate-800 bg-slate-950">
      <div
        class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5"
      >
        <a
          href="/"
          class="text-lg font-bold tracking-tight text-slate-100"
        >
          Muhammad Atif
        </a>

        <nav class="hidden items-center gap-6 text-sm font-medium md:flex">
          <a href="/" class="nav-link">Home</a>
          <a href="/about/" class="nav-link">About</a>
          <a href="/experience/" class="nav-link">Experience</a>
          <a href="/projects/" class="nav-link">Projects</a>
          <a href="/ai-lab/" class="nav-link">AI Lab</a>
          <a href="/articles/" class="nav-link">Articles</a>
          <a href="/resume/" class="nav-link">Resume</a>
          <a href="/contact/" class="nav-link">Contact</a>
        </nav>

        <button
          id="mobile-menu-button"
          type="button"
          aria-label="Open navigation menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="rounded-lg border border-slate-700 p-2 text-slate-300 transition hover:border-slate-600 hover:text-white md:hidden"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="h-6 w-6"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
            />
          </svg>
        </button>
      </div>

      <div
        id="mobile-menu"
        class="hidden border-t border-slate-800 bg-slate-950 md:hidden"
      >
        <nav
          class="mx-auto flex max-w-7xl flex-col px-6 py-4 text-sm font-medium"
        >
          <a
            href="/"
            class="border-b border-slate-800 py-3 text-slate-300 transition hover:text-white"
          >
            Home
          </a>

          <a
            href="/about/"
            class="border-b border-slate-800 py-3 text-slate-300 transition hover:text-white"
          >
            About
          </a>

          <a
            href="/experience/"
            class="border-b border-slate-800 py-3 text-slate-300 transition hover:text-white"
          >
            Experience
          </a>

          <a
            href="/projects/"
            class="border-b border-slate-800 py-3 text-slate-300 transition hover:text-white"
          >
            Projects
          </a>

          <a
            href="/ai-lab/"
            class="border-b border-slate-800 py-3 text-slate-300 transition hover:text-white"
          >
            AI Lab
          </a>

          <a
            href="/articles/"
            class="border-b border-slate-800 py-3 text-slate-300 transition hover:text-white"
          >
            Articles
          </a>

          <a
            href="/resume/"
            class="border-b border-slate-800 py-3 text-slate-300 transition hover:text-white"
          >
            Resume
          </a>

          <a
            href="/contact/"
            class="py-3 text-slate-300 transition hover:text-white"
          >
            Contact
          </a>
        </nav>
      </div>
    </header>

    <script>
      const button = document.getElementById("mobile-menu-button");
      const menu = document.getElementById("mobile-menu");

      button?.addEventListener("click", () => {
        const isOpen = button.getAttribute("aria-expanded") === "true";

        button.setAttribute("aria-expanded", String(!isOpen));
        button.setAttribute(
          "aria-label",
          isOpen ? "Open navigation menu" : "Close navigation menu",
        );

        menu?.classList.toggle("hidden");
      });
    </script>

    <main>
      <slot />
    </main>

    <footer class="border-t border-slate-800 bg-slate-950">
      <div
        class="mx-auto flex max-w-7xl flex-col gap-4 px-6 py-8 text-sm text-slate-400 md:flex-row md:items-center md:justify-between"
      >
        <div>
          <p class="font-medium text-slate-200">
            Muhammad Atif
          </p>

          <p class="mt-1">
            Senior Software Engineer · Enterprise Platforms · AI Engineering
          </p>
        </div>

        <div class="flex flex-wrap gap-5">
          <a
            href="/projects/"
            class="transition hover:text-slate-200"
          >
            Projects
          </a>

          <a
            href="/ai-lab/"
            class="transition hover:text-slate-200"
          >
            AI Lab
          </a>

          <a
            href="/resume/"
            class="transition hover:text-slate-200"
          >
            Resume
          </a>

          <a
            href="/contact/"
            class="transition hover:text-slate-200"
          >
            Contact
          </a>
        </div>
      </div>

      <div class="border-t border-slate-800">
        <div class="mx-auto max-w-7xl px-6 py-4 text-xs text-slate-500">
          © {new Date().getFullYear()} Muhammad Atif. Built with Astro.
        </div>
      </div>
    </footer>
  </body>
</html>